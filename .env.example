# Vector Database Configuration
# Options: "local" (zero-setup high-speed disk cache), "chroma" (embedded serverless), "pinecone" (cloud serverless)
VECTOR_DB_TYPE=local

# Pinecone Cloud Vector Database (Sign up free at https://www.pinecone.io)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agentic-ai-index
PINECONE_ENVIRONMENT=us-east-1

# NVIDIA NIM — the only LLM / embedding API provider
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_CHAT_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# RAG Pipeline Hyperparameters
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=4
RELEVANCE_THRESHOLD=0.45
